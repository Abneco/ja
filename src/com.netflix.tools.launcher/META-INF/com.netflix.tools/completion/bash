@FUNCTION@() {
    local current="${COMP_WORDS[COMP_CWORD]}"
    local candidates=(
@CANDIDATES@
    )
    COMPREPLY=()
    local candidate
    for candidate in "${candidates[@]}"; do
        if [[ "$candidate" == "$current"* ]]; then
            COMPREPLY+=("$candidate")
        fi
    done
}
complete -F @FUNCTION@ -- @COMMAND@
