@FUNCTION@() {
    local current="${COMP_WORDS[COMP_CWORD]}"
    local -a arguments=()
    if (( COMP_CWORD > 1 )); then
        arguments=("${COMP_WORDS[@]:1:$((COMP_CWORD - 1))}")
    fi
    COMPREPLY=()
    local value description
    while IFS=$'\t' read -r value description; do
        [[ "$value" == :* ]] && continue
        COMPREPLY+=("$value")
    done < <(command @COMMAND@ __complete "${arguments[@]}" "$current" 2>/dev/null)
}
complete -F @FUNCTION@ -- @COMMAND@
